; Engine configuration file.
; Edit through Godot when practical; this minimal project is intentionally asset-free.

config_version=5

[application]

config/name="YG3 Agent Garden"
run/main_scene="res://world.tscn"

[display]

window/size/viewport_width=256
window/size/viewport_height=256
window/size/window_width_override=256
window/size/window_height_override=256
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
